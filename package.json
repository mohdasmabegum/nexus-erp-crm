{
  "name": "nexus-erp-crm",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm --workspace client run dev",
    "server": "npm --workspace server run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --workspace server run build && npm --workspace client run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
